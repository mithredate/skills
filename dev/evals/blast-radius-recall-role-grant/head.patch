diff --git a/server/bookings.js b/server/bookings.js
index 8f73b0b..55b4b16 100644
--- a/server/bookings.js
+++ b/server/bookings.js
@@ -5,4 +5,9 @@ function updateBooking(actor, booking, changes) {
   return { ...booking, ...changes };
 }
 
-module.exports = { updateBooking };
+function refundBooking(actor, booking) {
+  if (!can(actor, 'booking.refund')) throw new Error('forbidden');
+  return { ...booking, status: 'refunded' };
+}
+
+module.exports = { updateBooking, refundBooking };
