diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..9a7a2cb
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,18 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { exportBookings } = require('../server/reports');
+
+test('an admin exports the bookings', () => {
+  const admin = { roles: ['admin'] };
+  const expected = '[{"id":1,"seats":2}]';
+
+  const sut = exportBookings(admin, [{ id: 1, seats: 2 }]);
+
+  assert.strictEqual(sut, expected);
+});
+
+test('support cannot export the bookings', () => {
+  const support = { roles: ['support'] };
+
+  assert.throws(() => exportBookings(support, [{ id: 1, seats: 2 }]), /forbidden/);
+});
