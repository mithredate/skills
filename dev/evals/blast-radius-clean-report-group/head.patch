@@ -0,0 +1,8 @@
+const { can } = require('./acl');
+
+function exportBookings(actor, bookings) {
+  if (!can(actor, 'report.export')) throw new Error('forbidden');
+  return JSON.stringify(bookings);
+}
+
+module.exports = { exportBookings };
