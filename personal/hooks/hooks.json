{
  "description": "When a code file changes, name the rubric that matches the file. Outside an agent, also tell the session to load personal:code-like-mehrdad. When a general-purpose or claude agent starts, give it the spawn rules.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-code-like-mehrdad-on-code-edit.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "general-purpose|claude",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/give-spawn-rules-on-agent-start.mjs\""
          }
        ]
      }
    ]
  }
}
