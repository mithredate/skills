{
  "description": "When an agent claims an orchestrator ticket that holds a brief, or prep writes a brief file, tell the agent to load dev:fire. When an edit changes the brief of an orchestrator ticket, tell the agent to load productivity:prep. When a skill or agent file of this marketplace changes, tell the agent to load productivity:write-a-skill.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-fire-on-brief.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-prep-on-brief-edit.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-write-a-skill-on-skill-change.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-write-a-skill-on-skill-change.mjs\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/load-write-a-skill-on-skill-change.mjs\""
          }
        ]
      }
    ]
  }
}
