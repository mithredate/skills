{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Read(~/.aws/**)", "Read(~/.kube/**)", "Edit(~/.aws/**)", "Edit(~/.kube/**)"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "allowWrite": [
        "~/.npm", "~/Library/pnpm/store", "~/go/pkg/mod", "~/Library/Caches/go-build", "~/Library/Caches/composer",
        "~/Library/Caches/pip", "~/projects", "/private/var/folders/*/*/T/**/*",
        "~/Library/Developer/MobileBuildMCP/workspaces", "~/Library/Developer/Xcode/DerivedData",
        "/private/tmp/e-*", "/private/tmp/e-*/**/*"
      ],
      "denyWrite": [
        "~/projects/**/.git/hooks",
        "~/projects/**/.githooks",
        "~/projects/**/.git/config",
        "~/projects/**/guard-infra/sandbox.json",
        "~/projects/**/.claude/settings.json",
        "~/projects/**/.claude/settings.local.json",
        "~/projects/**/.claude/skills",
        "~/projects/**/.claude/agents",
        "~/projects/**/.claude/commands",
        "~/projects/**/.claude/hooks",
        "~/projects/**/.mcp.json",
        "~/projects/**/.vscode",
        "~/projects/**/.idea",
        "~/.npm/_npx"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": ["com.apple.pasteboard.1"],
      "allowedDomains": [
        "github.com", "*.github.com", "*.githubusercontent.com", "registry.npmjs.org",
        "proxy.golang.org", "sum.golang.org", "repo.packagist.org", "pypi.org", "files.pythonhosted.org",
        "api.anthropic.com"
      ],
      "deniedDomains": ["*.amazonaws.com", "*.amazonaws.com.cn", "*.api.aws", "*.api.amazonwebservices.com.cn", "*.amazonaws.eu", "*.api.amazonwebservices.eu"]
    },
    "credentials": {
      "files": [
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.kube", "mode": "deny" }
      ],
      "envVars": [
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" }
      ]
    }
  }
}
